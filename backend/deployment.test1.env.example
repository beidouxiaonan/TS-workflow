# 复制为 deployment.test1.env，填写密码；三个数据库参数均在此配置。
NUZAR_DB_URL='jdbc:mysql://127.0.0.1:3306/ekbdb?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai&sslMode=PREFERRED'
NUZAR_DB_USERNAME='app_user'
NUZAR_DB_PASSWORD=''
SERVER_PORT=8080
LOG_PATH="${APP_HOME}/logs"
JAVA_OPTS='-Xms256m -Xmx512m'
# 填写该环境实际 JDK 8 安装目录，例如 /opt/jdk1.8.0_422；留空使用 PATH。
JAVA_HOME=""
