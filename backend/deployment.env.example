# 复制为 deployment.env 后填写。请勿将真实密码提交到版本库。
DB_URL='jdbc:mysql://127.0.0.1:3306/ekbdb?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai&sslMode=PREFERRED'
DB_USERNAME='app_user'
DB_PASSWORD='change-me'
SERVER_PORT=8080

# JVM 与日志限制
JAVA_OPTS='-Xms256m -Xmx512m -XX:+HeapDumpOnOutOfMemoryError'
LOG_PATH="${APP_HOME}/logs"
LOG_LEVEL=INFO
LOG_MAX_FILE_SIZE=50MB
LOG_MAX_HISTORY=14
LOG_TOTAL_SIZE_CAP=2GB
DB_POOL_SIZE=10
DB_POOL_MIN_IDLE=2
DB_INIT_MODE=never
# 填写该环境实际 JDK 8 安装目录，例如 /opt/jdk1.8.0_422；留空使用 PATH。
JAVA_HOME=""
